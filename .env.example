# ======================================================
# Explainroo Daily Script & Scene Generation Config
# ======================================================

# Primary: Google Gemini API (Recommended: gemini-2.5-flash)
# Get your free/low-cost key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Alternative: OpenAI API
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Alternative: Anthropic Claude API
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Alternative: OpenRouter API
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=google/gemini-2.5-flash

# API Server Configuration
PORT=3000
HOST=127.0.0.1
